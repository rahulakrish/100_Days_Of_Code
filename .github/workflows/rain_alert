name: rain alert

on:
  workflow_dispatch: 

jobs:
  run-script:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v4

    - name: Set up Python 3.10
      uses: actions/setup-python@v3
      with:
        python-version: "3.11"

    - name: Install dependencies
      run: |
        pip install requests json os smtplib   
       

    - name: run rain_alert script
      env:
          weather_api_key = os.environ.get('OWM_API_KEY)
      run: rain_alert_workflow
